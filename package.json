{
  "name": "@hibira-io/vue",
  "version": "0.2.1",
  "description": "Vue 3 and Vue 2.7 composables for pusher-js on Hibira and other Pusher-compatible servers: shared channels, events, presence, connection state, client events, and LLM token streaming with streamToChannel",
  "keywords": [
    "vue",
    "vue3",
    "vue2",
    "composables",
    "composition-api",
    "pusher",
    "pusher-js",
    "laravel-echo",
    "websocket",
    "realtime",
    "presence",
    "llm",
    "ai",
    "streaming",
    "hibira"
  ],
  "homepage": "https://hibira.io",
  "bugs": {
    "url": "https://github.com/hibira-io/vue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hibira-io/vue.git"
  },
  "license": "MIT",
  "author": "Hibira (https://hibira.io)",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "default": "./server.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "client.d.ts",
    "stream.js",
    "stream.d.ts",
    "agent.js",
    "agent.d.ts",
    "server.js",
    "server.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/e2e/*.e2e.mjs",
    "typecheck": "tsc -p test/tsconfig.json"
  },
  "peerDependencies": {
    "pusher-js": ">=7",
    "vue": "^2.7.0 || >=3.0.0"
  },
  "devDependencies": {
    "jsdom": "^27.4.0",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.44"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
